{
  "name": "quick-spapi-agentcore-adapter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT-0",
  "description": "AgentCore Gateway Lambda target: SP-API adapter for Amazon Quick (seller & vendor)",
  "type": "module",
  "main": "dist/handler.mjs",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=esm --external:@aws-sdk/* --outfile=dist/handler.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1108.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
