# ─── Copy to .env.seller or .env.vendor and fill in. Values are quoted because tokens
#     contain special characters (e.g. "|"). One selling partner per persona to start.
#     The persona comes from the script argument (./deploy.sh <seller|vendor>), not this file. ───

# SP-API region (this reference targets NA)
SP_API_REGION="NA"

# Use the SP-API sandbox (canned responses, no real data). Set "false" for production.
SP_API_SANDBOX="true"

# Opt-in: publish and allow tools that CHANGE account data (repricing, listings,
# PO acknowledgements, shipments, invoices). Leave "false" for a read-only connector.
ENABLE_WRITE_TOOLS="false"

# Optional: CloudWatch log retention for the adapter (days), and a cap on concurrent
# executions. Leave RESERVED_CONCURRENCY empty on accounts with a total limit of 10.
LOG_RETENTION_DAYS="30"
RESERVED_CONCURRENCY=""

# ─── LWA / SP-API application credentials (from your SP-API developer app) ───
LWA_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxxxxxxxxxx"
LWA_CLIENT_SECRET="amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxx"
# Refresh token for the authorized selling partner (seller or vendor).
SP_API_REFRESH_TOKEN="Atzr|xxxxxxxxxxxxxxxx"

# Seller-only: your selling partner / merchant token, used as {sellerId} by the Listings tools (reads and writes).
SELLER_ID=""

# ─── AWS deployment ───
AWS_REGION="us-east-1"
STACK_PREFIX="quick-spapi"

# Secrets Manager secret name the Lambda reads.
SP_API_SECRET_NAME="quick-spapi/seller/lwa"
